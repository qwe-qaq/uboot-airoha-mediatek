#include "mt7987a-u-boot.dtsi"
#include "mt7987-netsys-u-boot.dtsi"

/ {
	model = "GL.iNet GL-BE10000";
	compatible = "glinet,gl-be10000",
		     "mediatek,mt7987";
};

/*
 * LAN port, and the one to use. gmac1 drives the SoC built-in 2.5G PHY, which
 * mtk-2p5ge supports on MT7987. Its firmware is linked into U-Boot by
 * board/mediatek/mt7987/i2p5ge_fw.c, so it needs no storage and works before
 * any UBI exists.
 */
&eth1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio0_pins>;
	phy-mode = "internal";
	phy-handle = <&phy15>;

	phy15: eth-phy@15 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <15>;
	};
};

/* bootph-all throughout: the framebuffer is reserved before relocation */
&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	bootph-all;
	must_tx;
	enhance_timing;
	dma_ext;
	ipm_design;
	support_quad;
	tick_dly = <2>;
	sample_sel = <0>;

	display@0 {
		compatible = "sitronix,st7789p3";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-cpol;
		spi-cpha;
		bootph-all;

		/* BL2 drew the splash and left the controller running */
		skip-init;

		rotation = <270>;

		dc-gpios = <&pio 22 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 10 GPIO_ACTIVE_HIGH>;
		backlight = <&backlight>;
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm2_pins>;
	status = "okay";
	bootph-all;
};

/ {
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 2 50000>;
		brightness-levels = <0 16 32 48 64 80 96 112 128 144 160 176 192 208 224 255>;
		default-brightness-level = <12>;
		bootph-all;
	};
};

/*
 * pio 0 is the MDIO bus reset, active low. mtk_eth only releases it on the
 * switch code path, which this board does not take, so hog it high.
 */
&pio {
	bootph-all;

	spi1_pins: spi1-pins {
		mux {
			function = "spi";
			groups = "spi1_1";
		};
	};

	pwm2_pins: pwm2-pins {
		mux {
			function = "pwm";
			groups = "pwm2_0";
		};
	};

	mdio-reset-hog {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "mdio-reset";
	};
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_flash_pins>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	must_tx;
	enhance_timing;
	dma_ext;
	ipm_design;
	support_quad;
	tick_dly = <2>;
	sample_sel = <0>;

	spi_nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bl2";
				reg = <0x0 0x200000>;
			};

			partition@200000 {
				label = "ubi";
				reg = <0x200000 0x1fe00000>;
				compatible = "linux,ubi";
			};
		};
	};
};
