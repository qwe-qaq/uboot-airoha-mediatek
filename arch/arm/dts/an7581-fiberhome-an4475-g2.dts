/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include "an7581.dtsi"

/ {
	model = "FiberHome AN4475";
	compatible = "fiberhome,an4475",
		     "fiberhome,an4475-ct",
		     "airoha,an7581",
		     "airoha,en7581";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range = <0x0 0x80200000 0x0 0x1fe00000>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
		wlan {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 16 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};		
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "green:power";
			gpios = <&pinctrl 35 GPIO_ACTIVE_LOW>;
		};

		led-1 {
			label = "green:usb";
			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			label = "green:internet";
			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
		};

		led-3 {
			label = "green:lan1";
			gpios = <&pinctrl 42 GPIO_ACTIVE_LOW>;
		}
		
		led-4 {
			label = "green:lan2";
			gpios = <&pinctrl 43 GPIO_ACTIVE_LOW>;
		};

		led-5 {
			label = "green:lan3";
			gpios = <&pinctrl 44 GPIO_ACTIVE_LOW>;
		};

		led-6 {
			label = "green:lan4";
			gpios = <&pinctrl 45 GPIO_ACTIVE_LOW>;
		};
	};
};


&snfi {
	status = "okay";
};

&spi_nand {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bl2";
			reg = <0x0 0x20000>;
		};
		partition@20000 {
			label = "ubi";
			reg = <0x20000 0x000000>;
		};
	};
};

&i2c0 {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

